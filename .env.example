APP_NAME=Sola
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

# The cabinet has no database: sessions and cache are files on disk.
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# SOLA billing API
API_IP=127.0.0.1:808
SOLA_BASE_URL="http://${API_IP}"
SOLA_USERNAME=
SOLA_PASSWORD=
SOLA_SECRET_KEY=
SOLA_TIMEOUT=10
SOLA_CONNECT_TIMEOUT=3
SOLA_RETRY_TIMES=2
SOLA_RETRY_SLEEP_MS=150

# Answer the billing API in process instead of over the network, so the cabinet
# can be worked on off the VPN. Local environment only. See DOCKER.md.
SOLA_FAKE=false

# Skip only the SMS step (/identify and /verify), always into test account
# 1336708 — everything else still hits the real API, so the VPN must be up.
# Ignored when SOLA_FAKE is also on. Local environment only. See DOCKER.md.
SOLA_FAKE_LOGIN=false

CALL_CENTER=1130
CALL_PHONE='+99871 207 08 06'

# Dashboard entry points (config/sola.php). Har biri sozlanmaguncha
# tegishli kartochka ko'rinmaydi.
SOLA_PROMO_URL=
SOLA_LOYALTY_URL=
SOLA_CHAT_URL=
SOLA_CHAT_SCRIPT=

# iWon Business — balance top-up via Uzcard/Humo (config/iwon.php). A plain
# browser redirect: no signature, no callback. Off by default so a missing
# service id never sends a subscriber's card payment nowhere.
IWON_ACTIVE=false
IWON_SERVICE_ID=883
IWON_ACCOUNT_PARAM=acc_id
IWON_CURRENCY=UZS
IWON_FRAME_URL=https://business-frame.iwon.uz

# Activity journal: statistics, tariff-change history and admin audit
# (config/activity.php). Stores subscribers' phone, name and IP — keep it off in
# production until the lawyer has signed off (ZRU-547) and the privacy policy
# says so. Off: nothing is written, admin statistics show a notice.
ACTIVITY_ENABLED=false
# PostgreSQL. In Docker the host is the "postgres" service; on the server,
# 127.0.0.1. Run "php artisan activity:migrate --force" after changing it.
ACTIVITY_DB_HOST=postgres
ACTIVITY_DB_PORT=5432
ACTIVITY_DB_DATABASE=cabinet_activity
ACTIVITY_DB_USERNAME=cabinet
ACTIVITY_DB_PASSWORD=cabinet-local
ACTIVITY_DB_SSLMODE=prefer
# Offline IP → city (MaxMind GeoLite2-City .mmdb). Missing file → no city.
ACTIVITY_GEOIP_DATABASE=

# Device IP → city/country labels (ipwho.is, display-only, cached).
GEOIP_ACTIVE=false
GEOIP_TIMEOUT=2
GEOIP_CACHE_HOURS=24

# Telescope (dev only) — SQLite fayli database/database.sqlite da yotadi.
DB_CONNECTION=sqlite
TELESCOPE_ENABLED=false
